# Copy this file to .env and fill in the required values.
PIGMEN_IMAGE=ghcr.io/your-github-user/pigmenfarm:latest
DOCKER_PLATFORM=linux/arm64

PIGMEN_MODE=farm
PIGMEN_SERVER=play.example.net:25565
PIGMEN_USERNAME=pigmen-bot

# Leave empty for servers without /login authentication.
PIGMEN_LOGIN_PASSWORD=

PIGMEN_MIN_HEALTH=6.0
PIGMEN_MIN_DURABILITY=20

# These are used by base-notifier mode.
PIGMEN_WEBHOOK_URL=
PIGMEN_RENDER_DISTANCE=256
# 1 = sample every block; 4 = current faster setting.
PIGMEN_TERRAIN_SAMPLE_BLOCKS=4
PIGMEN_FALSE_ALARM_SECONDS=180
PIGMEN_WHITELIST=trusted_player,another_player
PIGMEN_ALERT_REPEATS=5
PIGMEN_PLAYER_DATABASE=/data/players.json
